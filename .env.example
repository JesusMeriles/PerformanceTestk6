# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO DE PRUEBAS DE RENDIMIENTO (k6 + Prometheus + Grafana)
# Copia este archivo a .env y ajusta los valores antes de ejecutar las pruebas.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. URLs BASE (2 URLs distintas según arquitectura)
# ------------------------------------------------------------------------------
# URL Base BFF: Utilizada para Login y Envío/Actualización de Evaluaciones
BASE_URL_BFF=http://localhost:3000

# URL Base Query: Utilizada para Consultar Evaluaciones mediante POST
BASE_URL_QUERY=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. RUTAS / ENDPOINTS
# ------------------------------------------------------------------------------
ENDPOINT_LOGIN=/api/auth/login
ENDPOINT_ASSESSMENT=/api/evaluaciones
ENDPOINT_QUERY=/api/evaluaciones/consulta

# ------------------------------------------------------------------------------
# 3. CREDENCIALES DE AUTENTICACIÓN (Payload BFF)
# Payload esperado: { "userName": "...", "password": "...", "ipAddress": "1", "deviceId": "hkAb" }
# ------------------------------------------------------------------------------
API_USER=admin
API_PASS=Testing123*
API_IP_ADDRESS=1
API_DEVICE_ID=hkAb

# ------------------------------------------------------------------------------
# 4. ESTRATEGIA DE AUTENTICACIÓN
# REGLA CRÍTICA: Realizar login nuevamente invalida el token previo.
#   1 = Login único en setup() y token compartido entre VUs (Recomendada).
#   2 = Un token por VU autenticado una sola vez (usando data/users.json).
#   3 = Pre-autenticación en setup() para todo el pool de usuarios en data/users.json.
#   4 = Login por iteración (SOLO para medir rendimiento puro del endpoint de login).
AUTH_STRATEGY=1

# ------------------------------------------------------------------------------
# 5. OBSERVABILIDAD (Prometheus Remote Write)
# ------------------------------------------------------------------------------
K6_PROMETHEUS_RW_SERVER_URL=http://localhost:9090/api/v1/write
K6_PROMETHEUS_RW_TREND_STATS=p(90),p(95),p(99),min,max

# ------------------------------------------------------------------------------
# 6. PARÁMETROS DE CARGA
# ------------------------------------------------------------------------------
VUS=50
DURATION=10m
THINK_TIME_MIN=1
THINK_TIME_MAX=3
